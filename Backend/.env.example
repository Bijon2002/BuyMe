# --- BUYME BACKEND CONFIGURATION ---

# 1. Server Configuration
PORT=8000
NODE_ENV=production

# 2. Database (MongoDB)
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db_name>
MONGO_URI=your_mongodb_connection_string_here

# 3. Security (JWT)
# Use a long random string for production
JWT_SECRET=your_jwt_secret_here

# 4. Email Service (Gmail App Password)
# Used for order confirmation, contact replies, and newsletter
EMAIL_USER=event.vibesz@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# 5. Hosting (CORS)
# The URL where your Cloudflare Pages frontend is hosted
FRONTEND_URL=https://your-buyme-site.pages.dev

# 6. API Base (For local development testing)
# REACT_APP_API_URL should be set in frontend .env
